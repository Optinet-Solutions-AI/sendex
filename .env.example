# Copy to .env and fill in. Never commit .env.

# --- Database (Supabase Postgres; the pooled URL for the apps, direct URL for migrations) ---
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (BullMQ queues, counters, rate limits). Upstash in prod; local redis in dev ---
REDIS_URL=redis://127.0.0.1:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- Open countries (D4-19) ---
# Countries a user can pick for a new campaign, a single SMS or a new list. Blank = the United
# Kingdom only; a list of 2-letter codes (GB,DE) opens those; "all" opens every country. Read
# when the web app is built, so change it on Vercel and redeploy. The closed countries stay
# visible in the dropdowns, greyed out.
NEXT_PUBLIC_OPEN_COUNTRIES=

# --- Development auth stub (local only; used by Playwright) ---
# With SENDEX_DEV_AUTH=1 and no Clerk keys, every request is signed in as a seeded user of the
# organisation below with the given role (owner | campaign_manager | viewer). Ignored whenever
# the Clerk keys are set, and always ignored when NODE_ENV=production.
SENDEX_DEV_AUTH=
SENDEX_DEV_ORG_SLUG=external
SENDEX_DEV_ROLE=owner

# --- Worker ---
WORKER_PORT=4000
WORKER_PUBLIC_URL=http://localhost:4000
POSTBACK_SIGNING_SECRET=change-me
# Shared with the links service for /internal/* (docs/engineering/links-and-clicks.md).
# Same value goes to Cloudflare: wrangler secret put INTERNAL_API_SECRET
INTERNAL_API_SECRET=change-me
# Safety net for first live sends (D2-18): when set, every provider refuses recipients not listed
# here (comma separated: exact E.164 numbers, or a prefix with a trailing * such as +356*) before the
# carrier is called. Leave empty in normal operation.
SEND_ALLOWLIST_E164=
# Queue workers (see docs/engineering/services-and-queues.md)
SEND_CONCURRENCY=5
SEND_RATE_PER_SECOND=50
INGEST_CONCURRENCY=5
# Redis command budget (D3-23): idle workers block this long per poll (a new job wakes them at once);
# /health reuses queue depths this long. Upstash bills per command below the fixed plans.
DRAIN_DELAY_SECONDS=30
QUEUE_DEPTH_CACHE_MS=60000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=30000
# Sending engine (see docs/engineering/sending-engine.md)
LAP_POLL_MS=5000
PAUSE_RETRY_MS=10000
# Delivery receipts (D3-01): a sent message with no receipt after DLR_EXPIRY_MS is expired; the sweep runs at most every DLR_EXPIRY_POLL_MS
DLR_EXPIRY_MS=86400000
DLR_EXPIRY_POLL_MS=60000
# Receipt poll (D2-23): ask carriers that can be polled (23Telecom REST) about `sent` messages whose
# webhook never came, after this grace period and at most this often.
# RECEIPT_POLL_AFTER_MS=600000
# RECEIPT_POLL_EVERY_MS=60000
# Shared secret for the worker's /internal/* routes (progress, laps, emergency stop); the web app sends it as x-internal-secret
INTERNAL_API_SECRET=change-me
# Where the web app reaches the worker's /internal/* routes (private network in prod); falls back to WORKER_PUBLIC_URL
WORKER_INTERNAL_URL=http://localhost:4000

# --- Links service (Cloudflare Worker) ---
# Base of the short links put in message texts (the worker's custom domain in prod).
LINKS_BASE_URL=http://localhost:8787
# Set in apps/links/wrangler.toml [vars] for wrangler dev / deploy; listed here for reference.
# Origin of the worker the links service falls back to and posts clicks to.
WORKER_URL=http://localhost:4000

# SMS Edge (D2-24): serves the `platform` routes (136, 137, 375, ...) when set; the FakeProvider otherwise.
# There is no sandbox: a key here sends real SMS and spends the account balance. Production value is a Fly secret.
SMS_EDGE_API_KEY=
# SMS_EDGE_BASE_URL=https://api.smsedge.com

# --- Providers ---
# 23Telecom REST API (docs.23telecom.co.uk). Registers the `23telecom` provider when set.
# sk_test_... simulates sends and synthesizes DELIVRD webhooks; sk_prod_... sends for real.
TELECOM23_API_KEY=
# Signing secret from the portal (Webhooks, Security); verifies /webhooks/23telecom/delivery.
TELECOM23_WEBHOOK_SECRET=
# TELECOM23_BASE_URL=https://restlink23telecom.com/api/v1
# 23Telecom over SMPP (registers the `smpp` provider when host, system id and password are set)
SMPP_HOST=127.0.0.1
SMPP_PORT=2775
SMPP_SYSTEM_ID=test
SMPP_PASSWORD=test
SMPP_TLS=false
SMPP_WINDOW=10
SMPP_TPS=
SMPP_PROVIDER_NAME=23telecom

# --- Observability ---
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=sendex

# --- Project management / repo (used by scripts only) ---
PMS_ACCESS_TOKEN=
PMS_PROJECT_URL=
GITHUB_REPO_LINK=
GITHUB_ACCESS_TOKEN=

# Segments › AI Rule Generator (web app only). Off unless ENABLE_AI_RULES=1; only then is
# ANTHROPIC_API_KEY needed. While off, the builder hides the generator.
ENABLE_AI_RULES=
ANTHROPIC_API_KEY=

# Routes › Custom Routes (web app seals, worker opens). 32 bytes as 64 hex characters, e.g.
# `openssl rand -hex 32`. Without it custom routes cannot be saved.
CUSTOM_ROUTE_SECRET_KEY=
