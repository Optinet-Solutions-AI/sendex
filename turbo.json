{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "envMode": "loose",
  "globalEnv": ["NODE_ENV", "CI"],
  "globalPassThroughEnv": [
    "BACKUP_DIR",
    "BACKUP_KEEP",
    "BACKUP_PREFIX",
    "PG_DUMP",
    "PG_RESTORE",
    "PSQL",
    "R2_ACCOUNT_ID",
    "R2_BUCKET",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["REDIS_URL"],
      "outputs": ["coverage/**"]
    }
  }
}
